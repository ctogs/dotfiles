#!/usr/bin/env bash
# Automated verification for bin/agent-sidebar.
# Boots an isolated tmux server (own socket) with fake clorch state files and a
# control-mode client, runs the sidebar in a pane, injects real key/mouse input
# via send-keys, and asserts the client actually jumps sessions/windows.
# Exit 0 = all checks pass. No interaction with the user's real tmux server.
set -uo pipefail

DIR="$(cd "$(dirname "$0")/.." && pwd)"
SOCK="sbtest$$"
TDIR="$(mktemp -d)"
STATE="$TDIR/state"
mkdir -p "$STATE"
FAILS=0

T() { tmux -L "$SOCK" "$@"; }
pass() { printf 'ok   %s\n' "$1"; }
fail() { printf 'FAIL %s\n' "$1"; FAILS=$((FAILS + 1)); }

cleanup() {
  T kill-server 2>/dev/null
  [[ -n "${KEEPER:-}" ]] && { kill "$KEEPER" 2>/dev/null; wait "$KEEPER" 2>/dev/null; }
  rm -rf "$TDIR"
}
trap cleanup EXIT

sleep 300 2>/dev/null &
KEEPER=$!

mkstate() {
  cat > "$STATE/$1.json" <<EOF
{"session_id":"$1","pid":$KEEPER,"status":"$5","tmux_session":"$2","tmux_window_index":"$3","tmux_window":"$4","project_name":"proj-$1","git_branch":"main"}
EOF
}
mkstate s1 feat-a 1 agent WORKING
mkstate s2 feat-b 1 agent IDLE
mkstate s3 feat-b 2 tests WAITING_PERMISSION
mkstate s4 "" "" "" IDLE

T -f /dev/null new-session -d -s feat-a -x 140 -y 40
T new-window -t feat-a -n agent
T new-session -d -s feat-b -x 140 -y 40
T new-window -t feat-b -n agent
T new-window -t feat-b -n tests

tail -f /dev/null | T -C attach -t feat-a >/dev/null 2>&1 &
CLIENT_FEEDER=$!
sleep 1
CLIENT="$(T list-clients -F '#{client_name}' | head -1)"
[[ -n "$CLIENT" ]] || { fail "control client attached"; exit 1; }

T select-window -t feat-a:0
PANE="$(T split-window -h -t feat-a:0 -l 40 -P -F '#{pane_id}' \
  "CLORCH_STATE_DIR=$STATE $DIR/bin/agent-sidebar")"

cap() { T capture-pane -p -t "$PANE" 2>/dev/null; }
cap_esc() { T capture-pane -p -e -t "$PANE" 2>/dev/null; }
row_of() { cap | grep -n -- "$1" | head -1 | cut -d: -f1; }
client_at() { T display-message -p -t "$CLIENT" '#{client_session}:#{active_window_index}' 2>/dev/null; }

wait_for() {
  local i
  for i in $(seq 1 40); do
    "$@" && return 0
    sleep 0.25
  done
  return 1
}

send_seq() {
  local hex
  hex="$(printf '%s' "$1" | xxd -p -c1 | tr '\n' ' ')"
  # shellcheck disable=SC2086
  T send-keys -t "$PANE" -H $hex
}
send_click() {
  send_seq "$(printf '\033[<0;5;%dM\033[<0;5;%dm' "$1" "$1")"
}

reset_client() {
  T switch-client -c "$CLIENT" -t feat-a
  T select-window -t feat-a:0
  T select-window -t feat-b:0
}

# --- 1. sidebar renders sessions and windows from state files ---
if wait_for sh -c "tmux -L $SOCK capture-pane -p -t $PANE 2>/dev/null | grep -q feat-b"; then
  pass "sidebar renders"
else
  fail "sidebar renders"
  cap
  exit 1
fi
for want in "feat-a" "feat-b" "agent" "tests" "other"; do
  if cap | grep -q -- "$want"; then
    pass "shows '$want'"
  else
    fail "shows '$want'"
  fi
done

# --- 2. click on a window row jumps client to that session+window ---
reset_client
ROW="$(row_of ' tests ')"
if [[ -z "$ROW" ]]; then
  fail "found 'tests' row"
else
  send_click "$ROW"
  if wait_for sh -c "[ \"\$(tmux -L $SOCK display-message -p -t $CLIENT '#{client_session}:#{active_window_index}')\" = feat-b:2 ]"; then
    pass "click window row jumps to feat-b:2"
  else
    fail "click window row jumps to feat-b:2 (client at $(client_at))"
  fi
fi

# --- 3. click on a session header jumps to that session ---
reset_client
ROW="$(row_of 'feat-b')"
send_click "$ROW"
if wait_for sh -c "[ \"\$(tmux -L $SOCK display-message -p -t $CLIENT '#{client_session}')\" = feat-b ]"; then
  pass "click session header jumps to feat-b"
else
  fail "click session header jumps to feat-b (client at $(client_at))"
fi

# --- 4. arrow keys move a visible selection highlight ---
reset_client
T send-keys -t "$PANE" Down
if wait_for sh -c "tmux -L $SOCK capture-pane -p -e -t $PANE 2>/dev/null | grep -q '\[7m'"; then
  pass "selection highlight visible after Down"
else
  fail "selection highlight visible after Down"
fi
hl_row() { cap_esc | grep -n '\[7m' | head -1 | cut -d: -f1; }
BEFORE="$(hl_row)"
T send-keys -t "$PANE" Down
if wait_for sh -c "[ \"\$(tmux -L $SOCK capture-pane -p -e -t $PANE 2>/dev/null | grep -n '\[7m' | head -1 | cut -d: -f1)\" != \"$BEFORE\" ]"; then
  pass "Down moves highlight"
else
  fail "Down moves highlight (stuck at row ${BEFORE:-none})"
fi

# --- 5. Enter opens the selected row ---
reset_client
for _ in 1 2 3 4 5 6 7 8; do T send-keys -t "$PANE" Down; done
sleep 0.5
SEL_ROW="$(cap_esc | grep -n '\[7m' | head -1 | cut -d: -f1)"
SEL_TEXT="$(cap | sed -n "${SEL_ROW}p")"
T send-keys -t "$PANE" Enter
if wait_for sh -c "[ \"\$(tmux -L $SOCK display-message -p -t $CLIENT '#{client_session}:#{active_window_index}')\" = feat-b:2 ]"; then
  pass "Enter on last row jumps to feat-b:2"
else
  fail "Enter on last row jumps to feat-b:2 (selected '$SEL_TEXT', client at $(client_at))"
fi

# --- 6. k moves selection back up, Enter jumps to feat-b:1 ---
reset_client
T send-keys -t "$PANE" k
sleep 0.3
T send-keys -t "$PANE" Enter
if wait_for sh -c "[ \"\$(tmux -L $SOCK display-message -p -t $CLIENT '#{client_session}:#{active_window_index}')\" = feat-b:1 ]"; then
  pass "k + Enter jumps to feat-b:1"
else
  fail "k + Enter jumps to feat-b:1 (client at $(client_at))"
fi

# --- 7. empty state dir: renders placeholder, keys don't crash it ---
EMPTY="$TDIR/empty"
mkdir -p "$EMPTY"
PANE2="$(T split-window -h -t feat-b:0 -l 40 -P -F '#{pane_id}' \
  "CLORCH_STATE_DIR=$EMPTY $DIR/bin/agent-sidebar")"
if wait_for sh -c "tmux -L $SOCK capture-pane -p -t $PANE2 2>/dev/null | grep -q 'no live claude sessions'"; then
  pass "empty state renders placeholder"
else
  fail "empty state renders placeholder"
fi
T send-keys -t "$PANE2" Down
T send-keys -t "$PANE2" Enter
sleep 1
if T list-panes -a -F '#{pane_id}' 2>/dev/null | grep -q "^$PANE2\$"; then
  pass "keys on empty sidebar don't crash it"
else
  fail "keys on empty sidebar don't crash it"
fi
T kill-pane -t "$PANE2" 2>/dev/null

# --- 8. q quits the sidebar ---
T send-keys -t "$PANE" q
if wait_for sh -c "! tmux -L $SOCK list-panes -a -F '#{pane_id}' 2>/dev/null | grep -q \"^$PANE\$\""; then
  pass "q quits sidebar"
else
  fail "q quits sidebar"
fi

kill "$CLIENT_FEEDER" 2>/dev/null

echo
if (( FAILS == 0 )); then
  echo "ALL PASS"
  exit 0
else
  echo "$FAILS FAILURE(S)"
  exit 1
fi
