#!/usr/bin/env bash
# Live list of Claude Code sessions grouped by tmux session (feature).
# Data source: clorch state files (read-only). Rows are clickable (jumps to the
# session's window); q quits. Run inside a tmux pane; see agent-sidebar-toggle.
set -uo pipefail

STATE_DIR="${CLORCH_STATE_DIR:-/tmp/clorch/state}"
Y=$'\033[33m'; B=$'\033[34m'; R=$'\033[31m'; G=$'\033[32m'; D=$'\033[2m'; M=$'\033[35m'; N=$'\033[0m'; BLD=$'\033[1m'

cleanup() {
  printf '\033[?1006l\033[?1000l\033[?25h'
  stty sane 2>/dev/null
}
trap cleanup EXIT
printf '\033[?1000h\033[?1006h\033[?25l'

icon() {
  case "$1" in
    WORKING) printf '%s○%s' "$B" "$N" ;;
    IDLE) printf '%s●%s' "$Y" "$N" ;;
    WAITING_ANSWER) printf '%s?%s' "$Y" "$N" ;;
    WAITING_PERMISSION) printf '%s‼%s' "$R" "$N" ;;
    ERROR) printf '%s✗%s' "$R" "$N" ;;
    *) printf '%s·%s' "$D" "$N" ;;
  esac
}

LINES_OUT=()
TARGETS=()

emit() {
  LINES_OUT+=("$1")
  TARGETS+=("${2:-}")
}

draw() {
  LINES_OUT=()
  TARGETS=()
  local rows="" f pid status tsess twin twini proj branch
  for f in "$STATE_DIR"/*.json; do
    [[ -e "$f" ]] || continue
    IFS=$'\x1f' read -r pid status tsess twini twin proj branch < <(
      jq -r '[.pid // 0, .status // "?", .tmux_session // "", .tmux_window_index // "", .tmux_window // "", .project_name // "?", .git_branch // ""] | map(tostring) | join("\u001f")' "$f" 2>/dev/null)
    [[ -n "${pid:-}" && "$pid" != "0" ]] || continue
    kill -0 "$pid" 2>/dev/null || continue
    rows+="${tsess:-~other}"$'\x1f'"$twini"$'\x1f'"$twin"$'\x1f'"$status"$'\x1f'"$proj"$'\x1f'"$branch"$'\n'
  done

  emit "$BLD AGENTS $N"
  if [[ -z "$rows" ]]; then
    emit "$D (no live claude sessions)$N"
  else
    local last="" t wi w s p br target
    while IFS=$'\x1f' read -r t wi w s p br; do
      [[ -n "$t" ]] || continue
      if [[ "$t" != "$last" ]]; then
        emit ""
        if [[ "$t" == "~other" ]]; then
          emit "$M▾ other$N"
        else
          emit "$M▾ $t$N" "=$t"
        fi
        last="$t"
      fi
      target=""
      [[ "$t" != "~other" ]] && target="=$t${wi:+:$wi}"
      emit " $(icon "$s") ${w:-$p}${br:+ $D$br$N}" "$target"
    done < <(printf '%s' "$rows" | sort)
  fi

  emit ""
  emit "$D● ready  ○ working  ‼ perm$N"
  emit "${D}click to jump · q quit · prefix+a hide$N"

  printf '\033[H\033[2J'
  printf '%s\033[K\n' "${LINES_OUT[@]}"
}

jump() {
  local y="$1" target
  (( y >= 1 && y <= ${#TARGETS[@]} )) || return 0
  target="${TARGETS[$((y - 1))]}"
  [[ -n "$target" ]] || return 0
  if [[ "$target" == *:* ]]; then
    tmux switch-client -t "${target%%:*}" 2>/dev/null
    tmux select-window -t "$target" 2>/dev/null
  else
    tmux switch-client -t "$target" 2>/dev/null
  fi
}

read_click() {
  local c b seq ch
  IFS= read -rsn1 -t 2 c || return 0
  [[ "$c" == 'q' ]] && exit 0
  [[ "$c" == $'\033' ]] || return 0
  IFS= read -rsn1 -t 1 b || return 0
  [[ "$b" == '[' ]] || return 0
  IFS= read -rsn1 -t 1 ch || return 0
  [[ "$ch" == '<' ]] || return 0
  seq=""
  while IFS= read -rsn1 -t 1 ch; do
    [[ "$ch" == "M" || "$ch" == "m" ]] && break
    seq+="$ch"
  done
  [[ "$ch" == "M" && "$seq" == 0\;* ]] || return 0
  jump "${seq##*;}"
}

while :; do
  draw
  read_click
done
