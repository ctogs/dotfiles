#!/usr/bin/env bash
# Live list of Claude Code sessions grouped by tmux session (feature).
# Data source: clorch state files (read-only). Click a row to jump to that
# session/window, or navigate with arrows/jk and open with Enter; wheel scrolls
# the selection; q quits. Run inside a tmux pane; see agent-sidebar-toggle.
# Verified by tests/agent-sidebar-test.
set -uo pipefail

STATE_DIR="${CLORCH_STATE_DIR:-/tmp/clorch/state}"
Y=$'\033[33m'; B=$'\033[34m'; R=$'\033[31m'; G=$'\033[32m'; D=$'\033[2m'; M=$'\033[35m'; N=$'\033[0m'; BLD=$'\033[1m'; REV=$'\033[7m'

cleanup() {
  printf '\033[?1006l\033[?1000l\033[?25h'
  stty sane 2>/dev/null
}
trap cleanup EXIT
printf '\033[?1000h\033[?1006h\033[?25l'

icon_glyph() {
  case "$1" in
    WORKING) printf '○' ;;
    IDLE) printf '●' ;;
    WAITING_ANSWER) printf '?' ;;
    WAITING_PERMISSION) printf '‼' ;;
    ERROR) printf '✗' ;;
    *) printf '·' ;;
  esac
}

icon_color() {
  case "$1" in
    WORKING) printf '%s' "$B" ;;
    IDLE | WAITING_ANSWER) printf '%s' "$Y" ;;
    WAITING_PERMISSION | ERROR) printf '%s' "$R" ;;
    *) printf '%s' "$D" ;;
  esac
}

LINES_OUT=()
PLAIN_OUT=()
TARGETS=()
SELECTABLE=()
SEL_TARGET=""
SEL_IDX=-1

emit() {
  LINES_OUT+=("$1")
  TARGETS+=("${2:-}")
  PLAIN_OUT+=("${3:-$1}")
}

build() {
  LINES_OUT=()
  PLAIN_OUT=()
  TARGETS=()
  SELECTABLE=()
  local rows="" f pid status tsess twin twini proj branch
  for f in "$STATE_DIR"/*.json; do
    [[ -e "$f" ]] || continue
    IFS=$'\x1f' read -r pid status tsess twini twin proj branch < <(
      jq -r '[.pid // 0, .status // "?", .tmux_session // "", .tmux_window_index // "", .tmux_window // "", .project_name // "?", .git_branch // ""] | map(tostring) | join("")' "$f" 2>/dev/null)
    [[ -n "${pid:-}" && "$pid" != "0" ]] || continue
    kill -0 "$pid" 2>/dev/null || continue
    rows+="${tsess:-~other}"$'\x1f'"$twini"$'\x1f'"$twin"$'\x1f'"$status"$'\x1f'"$proj"$'\x1f'"$branch"$'\n'
  done

  emit "$BLD AGENTS $N"
  if [[ -z "$rows" ]]; then
    emit "$D (no live claude sessions)$N"
  else
    local last="" t wi w s p br target gl col line plain
    while IFS=$'\x1f' read -r t wi w s p br; do
      [[ -n "$t" ]] || continue
      if [[ "$t" != "$last" ]]; then
        emit ""
        if [[ "$t" == "~other" ]]; then
          emit "${M}▾ other$N"
        else
          emit "${M}▾ $t$N" "=$t" "▾ $t"
        fi
        last="$t"
      fi
      target=""
      [[ "$t" != "~other" ]] && target="=$t${wi:+:$wi}"
      gl="$(icon_glyph "$s")"
      col="$(icon_color "$s")"
      line=" ${col}${gl}${N} ${w:-$p}"
      plain=" ${gl} ${w:-$p}"
      if [[ -n "$br" ]]; then
        line+=" ${D}${br}${N}"
        plain+=" ${br}"
      fi
      emit "$line" "$target" "$plain"
    done < <(printf '%s' "$rows" | sort)
  fi

  emit ""
  emit "${D}● ready  ○ working  ‼ perm$N"
  emit "${D}↑↓/jk move · ⏎/click open$N"
  emit "${D}q quit · prefix+a hide$N"

  local i
  for i in "${!TARGETS[@]}"; do
    [[ -n "${TARGETS[$i]}" ]] && SELECTABLE+=("$i")
  done
  resolve_sel
}

resolve_sel() {
  local i
  SEL_IDX=-1
  if [[ -n "$SEL_TARGET" ]]; then
    for i in "${!TARGETS[@]}"; do
      if [[ -n "${TARGETS[$i]}" && "${TARGETS[$i]}" == "$SEL_TARGET" ]]; then
        SEL_IDX=$i
        return
      fi
    done
  fi
  for i in "${!TARGETS[@]}"; do
    if [[ -n "${TARGETS[$i]}" ]]; then
      SEL_IDX=$i
      SEL_TARGET="${TARGETS[$i]}"
      return
    fi
  done
  SEL_TARGET=""
}

render() {
  printf '\033[H\033[2J\033[?1000h\033[?1006h'
  local i
  for i in "${!LINES_OUT[@]}"; do
    if (( i == SEL_IDX )); then
      printf '%s\033[K\n' "${REV}${PLAIN_OUT[$i]}${N}"
    else
      printf '%s\033[K\n' "${LINES_OUT[$i]}"
    fi
  done
}

move_sel() {
  local delta="$1" n="${#SELECTABLE[@]}" pos=-1 i
  (( n > 0 )) || return 0
  for i in "${!SELECTABLE[@]}"; do
    if (( SELECTABLE[i] == SEL_IDX )); then
      pos=$i
      break
    fi
  done
  if (( pos < 0 )); then
    pos=0
  else
    pos=$(( pos + delta ))
  fi
  (( pos < 0 )) && pos=0
  (( pos >= n )) && pos=$(( n - 1 ))
  SEL_IDX="${SELECTABLE[$pos]}"
  SEL_TARGET="${TARGETS[$SEL_IDX]}"
}

jump_target() {
  local target="$1"
  [[ -n "$target" ]] || return 0
  if [[ "$target" == *:* ]]; then
    tmux switch-client -t "${target%%:*}" 2>/dev/null
    tmux select-window -t "$target" 2>/dev/null
  else
    tmux switch-client -t "$target" 2>/dev/null
  fi
}

click_row() {
  local y="$1"
  [[ "$y" == *[!0-9]* || -z "$y" ]] && return 0
  (( y >= 1 && y <= ${#TARGETS[@]} )) || return 0
  local idx=$(( y - 1 ))
  [[ -n "${TARGETS[$idx]}" ]] || return 0
  SEL_IDX=$idx
  SEL_TARGET="${TARGETS[$idx]}"
  jump_target "$SEL_TARGET"
}

read_input() {
  local c b ch seq btn
  IFS= read -rsn1 -t 2 c || return 0
  case "$c" in
    q) exit 0 ;;
    j) move_sel 1 ;;
    k) move_sel -1 ;;
    '' | $'\n' | $'\r') jump_target "$SEL_TARGET" ;;
    $'\033')
      IFS= read -rsn1 -t 1 b || return 0
      [[ "$b" == '[' || "$b" == 'O' ]] || return 0
      IFS= read -rsn1 -t 1 ch || return 0
      case "$ch" in
        A) move_sel -1 ;;
        B) move_sel 1 ;;
        '<')
          seq=""
          while IFS= read -rsn1 -t 1 ch; do
            [[ "$ch" == 'M' || "$ch" == 'm' ]] && break
            seq+="$ch"
          done
          [[ "$ch" == 'M' ]] || return 0
          btn="${seq%%;*}"
          case "$btn" in
            0) click_row "${seq##*;}" ;;
            64) move_sel -1 ;;
            65) move_sel 1 ;;
          esac
          ;;
      esac
      ;;
  esac
}

while :; do
  build
  render
  read_input
done
