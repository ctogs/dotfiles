#!/usr/bin/env bash
# Toggle the agents sidebar pane on the left of the current tmux window.
set -uo pipefail

existing="$(tmux list-panes -F '#{pane_id} #{pane_start_command}' | awk '/agent-sidebar($| )/ {print $1; exit}')"
if [[ -n "$existing" ]]; then
  tmux kill-pane -t "$existing"
else
  tmux split-window -hbf -l 34 -d "$HOME/dotfiles/bin/agent-sidebar"
fi
